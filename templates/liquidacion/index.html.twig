{% extends 'base.html.twig' %}

{% block title %}Liquidaciones{% endblock %}

{% block body %}
    <div style="margin: 2em auto; max-width: 900px; font: 16px/1.5 sans-serif;">
        <h1>Liquidaciones</h1>

        <table border="1" cellpadding="8" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Propiedad</th>
                    <th>Período</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>modificar</th>
                </tr>
            </thead>
            <tbody>
                {% for liquidacion in liquidaciones %}
                    <tr>
                        <td>
                            <a href="{{ path('app_liquidacion_show', {id: liquidacion.id}) }}" data-turbo="false">
                                {{ liquidacion.id }}
                            </a>
                        </td>
                        <td>{{ liquidacion.propiedad.nombre }}</td>
                        <td>{{ liquidacion.periodo }}</td>
                        <td>{{ liquidacion.estado }}</td>
                        <td>{{ liquidacion.total }}</td>
                        <td><a href="{{ path('app_liquidacion_modify_form', {id: liquidacion.id}) }}" data-turbo="false">
                                Edit
                            </a></td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">No hay liquidaciones</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h1>Liquidaciones</h1>
        <p>
            <a href="{{ path('facturacion_nueva') }}" data-turbo="false">Generar facturación</a>
        </p>
    </div>

<style>
  table {
    width: 100%;
    border-collapse: collapse; /* Une los bordes en una sola línea */
  }

  th, td {
    border: 1px solid #ccc; /* Define el grosor, estilo y color de la línea */
    padding: 8px;           /* Espacio interno para mayor legibilidad */
    text-align: left;
  }

  th {
    background-color: #f2f2f2;
  }
</style>

{% endblock %}


