{% extends 'base.html.twig' %}

{% block title %}Nueva facturación{% endblock %}

{% block body %}
{% include 'partials/pop_styles.html.twig' %}

<div class="pop-page">
    <header class="pop-topbar">
        <div class="pop-brand">
            <span class="pop-dots" aria-hidden="true"></span>
            <strong>Facturación</strong>
            <span class="pop-muted">· Generar</span>
        </div>
        <a class="pop-btn pop-btn--ghost" href="{{ path('app_liquidacion_index') }}" data-turbo="false">
            Ver liquidaciones
        </a>
    </header>

    <main class="pop-main">
        <div class="pop-panel">
            <p class="pop-pill">Facturación</p>
            <h1>Generador de facturación</h1>
            <p class="pop-subtitle">
                Elige un período, revisa el preview y confirma para emitir la factura.
            </p>

            {% for message in app.flashes('success') %}
                <div class="pop-flash pop-flash--success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="pop-flash pop-flash--error">{{ message }}</div>
            {% endfor %}

            {{ form_start(form, { attr: { 'data-turbo': 'false' } }) }}
                {{ form_row(form.periodo) }}
                <div class="pop-actions-row">
                    <button type="submit">Generar preview</button>
                </div>
            {{ form_end(form) }}

            {% if preview %}
                <h2>Preview</h2>
                <p class="pop-note">
                    Estas {{ preview.cantidad }} liquidaciones se incluirán.
                </p>

                <table class="pop-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Propiedad</th>
                            <th>Empresa</th>
                            <th>Receptor</th>
                            <th>Período</th>
                            <th>Estado</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for liquidacion in preview.liquidaciones %}
                            <tr>
                                <td>{{ liquidacion.id }}</td>
                                <td>{{ liquidacion.propiedad.nombre }}</td>
                                <td>{{ liquidacion.propiedad.empresa.razonSocial }}</td>
                                <td>{{ liquidacion.propiedad.arrendatario.nombre }}</td>
                                <td>{{ liquidacion.periodo }}</td>
                                <td>
                                    <span class="pop-badge pop-badge--{{ liquidacion.estado }}">
                                        {{ liquidacion.estado }}
                                    </span>
                                </td>
                                <td class="pop-total">
                                    ${{ liquidacion.total|number_format(0, ',', '.') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <h3>Totales</h3>
                <ul class="pop-list">
                    <li>
                        Neto:
                        <span class="pop-total">${{ preview.neto|number_format(0, ',', '.') }}</span>
                    </li>
                    <li>
                        IVA 19%:
                        <span class="pop-total">${{ preview.iva|number_format(0, ',', '.') }}</span>
                    </li>
                    <li>
                        Total:
                        <span class="pop-total">${{ preview.total|number_format(0, ',', '.') }}</span>
                    </li>
                </ul>

                <form action="{{ path('facturacion_confirmar') }}" method="post">
                    <input type="hidden" name="periodo" value="{{ preview.periodo }}">
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('facturar_' ~ preview.periodo) }}"
                    >
                    <div class="pop-actions-row">
                        <button type="submit">Confirmar y crear factura</button>
                    </div>
                </form>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
